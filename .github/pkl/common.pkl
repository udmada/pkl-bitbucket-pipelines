import "@com.github.actions/AbstractTypedStep.pkl"
import "@com.github.actions/Step.pkl"

import "actions/CheckoutAction.pkl"
import "actions/MiseAction.pkl"

/// The published package name. Must match `package.name` in the root `PklProject`, since the
/// release workflow triggers on `<packageName>@*` tags.
const packageName = "com.atlassian.bitbucket.pipelines"

/// Check out the repository and install the toolchain declared in `mise.toml`.
///
/// mise provides both pkl and java, so no `setup-pkl` or `setup-java` step is needed, and every
/// job can call the same `mise run` tasks used locally.
steps: Listing<*Step | AbstractTypedStep> = new Listing {
  (CheckoutAction) {
    with {
      `fetch-depth` = 1
    }
  }
  // Installs whatever `mise.toml` declares — the tool versions live there, not here.
  MiseAction
}

amends "@com.github.actions/Workflow.pkl"

import "@com.github.actions/Step.pkl"

import "common.pkl"

name = "CI"

on {
  push {
    branches { "master" }
  }
  pull_request {}
}

jobs {
  ["test"] {
    `runs-on` = "ubuntu-latest"
    steps = (common.steps) {
      (Step) {
        // The schema module on its own is deliberately invalid — a config with no pipelines is not
        // a pipeline — so evaluate an example instead.
        name = "Check the schema evaluates"
        run = "pkl eval examples/basic.pkl"
      }
      (Step) {
        name = "Run tests"
        run = "mise run test"
      }
      (Step) {
        // Deliberately the lenient variant: the strict check fails for any content change once a
        // version is published, which would block every push until the version is bumped.
        name = "Check the package builds"
        run = "mise run package:verify"
      }
      (Step) {
        name = "Verify generated workflows are up to date"
        run = """
          mise run pkl:gen
          git diff --exit-code .github/
          """
      }
    }
  }
}

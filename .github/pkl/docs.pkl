/// Publishes pkldoc-generated API documentation to GitHub Pages.
///
/// The generation itself is the `doc` task in `mise.toml`, which fetches the JVM `pkl-tools` jar
/// because the native pkl CLI has no `doc` subcommand. Keeping it there rather than inline means the
/// command is identical locally and in CI, and java comes from `mise.toml` along with pkl.
///
/// Requires Pages to be enabled for the repository with "Source" set to "GitHub Actions".
amends "@com.github.actions/Workflow.pkl"

import "@com.github.actions/catalog.pkl"
import "@com.github.actions/Step.pkl"

import "common.pkl"

name = "Docs"

on {
  push {
    branches { "master" }
  }
  workflow_dispatch {}
}

jobs {
  ["generate"] {
    `runs-on` = "ubuntu-latest"
    steps = (common.steps) {
      (Step) {
        name = "Generate pkldoc"
        run = "mise run doc"
      }
      (catalog.`actions/upload-pages-artifact@v5`) {
        with {
          path = ".out/doc"
        }
      }
    }
  }
  ["deploy"] {
    `runs-on` = "ubuntu-latest"
    needs = "generate"
    permissions {
      pages = "write"
      `id-token` = "write"
    }
    steps {
      catalog.`actions/deploy-pages@v5`
    }
  }
}

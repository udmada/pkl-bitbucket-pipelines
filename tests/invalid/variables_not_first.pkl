// Invalid: custom pipeline variables must be declared as the first element.
// expect: A variables element must be the first element of its pipeline.
amends "../../Config.pkl"

pipelines {
  custom {
    ["release"] {
      new Step {
        script { "./build.sh" }
      }
      new Variables {
        variables {
          new { name = "channel" }
        }
      }
    }
  }
}

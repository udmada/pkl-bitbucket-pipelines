// Invalid: a variable name cannot start with a digit.
// expect: `matches(Regex(#"[A-Za-z_][A-Za-z0-9_]*"#))`
amends "../../Config.pkl"

pipelines {
  custom {
    ["release"] {
      new Variables {
        variables {
          new { name = "1CHANNEL" }
        }
      }
      new Step {
        script { "./build.sh" }
      }
    }
  }
}

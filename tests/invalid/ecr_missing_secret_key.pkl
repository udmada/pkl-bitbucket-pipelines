// Invalid: ECR authentication needs `access-key` and `secret-key` together, or `oidc-role` alone.
amends "../../Config.pkl"

image = new ImageSpec {
  name = "123456789012.dkr.ecr.us-east-1.amazonaws.com/app:latest"
  aws {
    `access-key` = "$AWS_ACCESS_KEY"
  }
}

pipelines {
  `default` {
    new Step {
      script { "./build.sh" }
    }
  }
}

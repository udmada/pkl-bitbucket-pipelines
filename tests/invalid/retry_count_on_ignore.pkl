// Invalid: `maxRetryCount` is only meaningful when the strategy is `retry`.
// expect: `this == null || (strategy == "retry" && isBetween(1, 10))`
amends "../../Config.pkl"

pipelines {
  `default` {
    new Step {
      script { "./build.sh" }
      `on-fail` {
        strategy = "ignore"
        maxRetryCount = 3
      }
    }
  }
}

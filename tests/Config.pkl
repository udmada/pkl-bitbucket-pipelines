/// Snapshot tests: every example under `examples/`, and every edge case under `tests/valid/`, is
/// rendered to YAML and compared against `Config.pkl-expected.pcf`.
///
/// `tests/valid/` holds configurations that must keep evaluating — the counterpart of
/// `tests/invalid/` — so that tightening a constraint cannot silently reject something legal.
///
/// Run with `pkl test tests/Config.pkl`, and re-record with `--overwrite` after an intended
/// change to the schema or the examples.
module com.atlassian.bitbucket.pipelines.tests.Config

amends "pkl:test"

local allExamples = import*("../examples/*.pkl")

local validCases = import*("valid/*.pkl")

examples {
  for (example in allExamples.keys) {
    [example.drop("../examples/".length).replaceLast("pkl", "yaml")] {
      allExamples[example].output.text
    }
  }
  for (validCase in validCases.keys) {
    [validCase.replaceLast("pkl", "yaml")] {
      validCases[validCase].output.text
    }
  }
}

/// Write Bitbucket Pipelines configuration with Pkl.
///
/// Consumed by pkldoc to title and link the generated documentation.
///
/// Everything here is derived from `PklProject`, which is the single source of truth for the
/// package name and version — there is nothing to keep in sync by hand. Because of that import,
/// this module is excluded from the published package, where `PklProject` is not present.
amends "pkl:DocPackageInfo"

import "PklProject" as project

local pkg = project.package

name = pkg.name

version = pkg.version

importUri = "\(pkg.baseUri)@\(pkg.version)/"

sourceCode = pkg.website

issueTracker = pkg.issueTracker

authors = pkg.authors
